rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authoritative Admin Authorization via Firebase Auth Custom Claims
    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    // Products Collection
    // Public: Read allowed ONLY if enabled == true
    // Admins: Full read and write access
    match /products/{productId} {
      allow read: if resource.data.enabled == true || isAdmin();

      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.categoryId is string;

      allow update, delete: if isAdmin();
    }

    // Categories Collection
    // Public: Read allowed if enabled == true
    // Admins: Full read and write access
    match /categories/{categoryId} {
      allow read: if resource.data.enabled == true || isAdmin();
      allow write: if isAdmin();
    }

    // Testimonials Collection
    // Public: Read allowed if enabled == true
    // Admins: Full read and write access
    match /testimonials/{testimonialId} {
      allow read: if resource.data.enabled == true || isAdmin();
      allow write: if isAdmin();
    }

    // Admins Collection
    // Strictly restricted to authorized administrators
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
